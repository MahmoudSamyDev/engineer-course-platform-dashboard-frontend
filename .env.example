# Copy to .env for local development. Every VITE_* value ends up in the browser bundle:
# never put secrets here (SRS DC-08).

# Base URL of the shared backend API (the Website app). Admin routes live under /admin.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# true = answer API calls from the in-browser mock (MSW) — development only.
VITE_API_MOCKING=true

# Build-time only. true = ALSO keep the mock in a production build, for a public demo with
# sample data and no backend (needs VITE_API_MOCKING=true too). Never set it on a real deployment.
# VITE_DEMO=true
